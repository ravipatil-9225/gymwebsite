# ZKTeco K40 Pro Machine IP & Port (Local Gym Network)
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370

# Gym Website Cloud Backend Endpoint
CLOUD_API_URL=https://your-gym-website.com/api/attendance/biometric-punch

# Secret bridge key (must match BIOMETRIC_BRIDGE_SECRET in backend .env)
BIOMETRIC_BRIDGE_SECRET=gym_biometric_secret_2026

# Polling fallback interval in seconds (optional)
SYNC_INTERVAL_SECONDS=10
