# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables (NEVER commit these - contain secrets)
.env
frontend/.env
backend/.env
*.env.local
*.env.production

# Build output
frontend/dist/
frontend/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Uploaded files / large media that shouldn't be in git
public/gallery/
backend/uploads/

# ── CLEANUP RULES (added during Phase 3 hardening) ──
# Temp/dev files — should never reach the repo
temp_*.jsx
temp_*.js
temp_*.txt
*_old.jsx
*_old.js

# Diff / debug dumps
*.diff
diff.txt
spy_*.js

# One-off build and test logs
build_output*.txt
test_results.txt

# Developer reference notes folder
_dev_notes/

# Load testing scripts (dev-only, not for production repo)
backend/load-test.js
backend/load_test_results.txt
